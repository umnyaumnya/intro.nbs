# ──────────────────────────────────────────────
# macOS 시스템 파일
# 폴더마다 자동 생성되는 macOS 메타데이터 (썸네일/뷰 설정 등)
# ──────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# ──────────────────────────────────────────────
# Windows 시스템 파일
# ──────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ──────────────────────────────────────────────
# 에디터 / IDE 설정 파일
# 개인별로 다르게 쓰는 설정이라 공유 X
# ──────────────────────────────────────────────
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
.history/
.cursor/

# ──────────────────────────────────────────────
# 로그 / 임시 파일
# ──────────────────────────────────────────────
*.log
logs/
tmp/
temp/
*.tmp
*.cache
.cache/

# ──────────────────────────────────────────────
# 백업 파일 (실수로 생긴 사본이 같이 올라가지 않도록)
# ──────────────────────────────────────────────
*.bak
*.backup
*.old
*.orig
*~$*
*_backup*
*_복사본*
*_사본*

# ──────────────────────────────────────────────
# 개인 정보 / 자격 증명 (절대 깃에 올리면 안 되는 것들)
# 비밀번호, API 키, 토큰, 인증서, 개인키 등
# ──────────────────────────────────────────────
.env
.env.*
*.env
secrets.*
credentials.*
*_secret*
*_credential*
*_password*
*_token*
*_apikey*
*_api_key*
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
.ssh/
.aws/
.gcloud/
.azure/

# ──────────────────────────────────────────────
# 회사/내부 자료가 실수로 들어오는 걸 막기 위한 방어선
# 파일명에 'confidential', '대외비', '내부용' 같은 단어가 있으면 자동 제외
# ──────────────────────────────────────────────
*confidential*
*Confidential*
*CONFIDENTIAL*
*대외비*
*내부용*
*비공개*
*draft*
*초안*

# ──────────────────────────────────────────────
# 의존성 / 빌드 결과물 (앞으로 도구를 더 쓰게 되면 자동 생성됨)
# ──────────────────────────────────────────────
node_modules/
bower_components/
vendor/
dist/
build/
out/
.next/
.nuxt/
.parcel-cache/

# ──────────────────────────────────────────────
# 데이터베이스 / 데이터 덤프
# ──────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db
*.sql
*.dump

# ──────────────────────────────────────────────
# 압축 파일 (큰 자료가 통째로 올라가지 않도록)
# 사이트에 꼭 필요한 zip이 있다면 아래에 '! 파일명' 으로 예외 처리할 수 있음
# ──────────────────────────────────────────────
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# ──────────────────────────────────────────────
# 패키지 매니저 자동 생성 파일 (현재는 안 쓰지만 향후 대비)
# ──────────────────────────────────────────────
.npm/
.yarn/
.pnpm-store/
.npmrc
.yarnrc

# ──────────────────────────────────────────────
# Decap CMS 등 외부 도구 캐시 (나중에 CMS 붙일 때 자동 적용됨)
# ──────────────────────────────────────────────
.cms-cache/
admin/config.local.yml
